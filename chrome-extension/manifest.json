{
  "manifest_version": 3,
  "name": "Genjutsu AI",
  "version": "1.0.0",
  "description": "Upload media and open Genjutsu AI to create motion-transfer and object-swap videos.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Genjutsu AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
